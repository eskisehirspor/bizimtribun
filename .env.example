APP_URL=http://localhost:3000
APP_SECRET=uzun-rastgele-bir-gizli-anahtar

# Production: absolute path on persistent disk. Required when NODE_ENV=production.
# BIZIM_TRIBUN_DB=/var/lib/bizim-tribun/bizim-tribun.db
# DB_BACKUP_DIR=/var/lib/bizim-tribun/backups
# DB_BACKUP_RETENTION=7

# Boş bırakılırsa doğrulama linki geliştirmede konsola ve data/last-verify-link.txt dosyasına yazılır.
RESEND_API_KEY=
MAIL_FROM=Bizim Tribun <noreply@localhost>

# Session çerezleri APP_SECRET ile HMAC'lenir. Üyelik parolası scrypt hash olarak saklanır.

# Sayım oyu: true olunca e-posta + telefon OTP zorunlu. Boş / false = launch mode (yalnız e-posta).
PHONE_VERIFICATION_ENABLED=false

# Client IP / rate limit. Client bu değeri değiştiremez.
# none (varsayılan): x-forwarded-for, x-real-ip, cf-connecting-ip yok sayılır.
# cloudflare: yalnızca cf-connecting-ip (trafik Cloudflare üzerinden gelmeli).
# forwarded: tek/az hop'lu güvenilir reverse proxy (nginx). X-Forwarded-For zincirinin
# sağından TRUST_PROXY_HOPS kadar içerdeki IP alınır (sahte sol hop'lar düşer).
# TRUST_PROXY=none
# TRUST_PROXY_HOPS=1

# Yalnızca development: bu kullanıcı adı veya e-posta eşleşirse hesap admin yapılır.
# Production'da yok sayılır. Kayıt olduktan sonra bir istek at veya sunucuyu yeniden başlat.
# BOOTSTRAP_ADMIN_USERNAME=senin_kullanici_adin
# BOOTSTRAP_ADMIN_EMAIL=sen@ornek.com
