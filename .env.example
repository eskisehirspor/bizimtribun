# Kopyala: cp .env.example .env.local  (geliştirme)
# Üretimde bu değerleri sunucunun ortam değişkenlerine yaz; gerçek anahtarları depoya koyma.

APP_URL=http://localhost:3000
# Üretimde en az 32 rastgele karakter (bu yer tutucu kısa olduğu için üretimde reddedilir).
# Üretmek için: openssl rand -base64 48
APP_SECRET=DEGISTIR

# Üretimde zorunlu: kalıcı diskte mutlak yol.
# BIZIM_TRIBUN_DB=/var/lib/bizim-tribun/bizim-tribun.db
# DB_BACKUP_DIR=/var/lib/bizim-tribun/backups
# DB_BACKUP_RETENTION=7

# --- SMS (giriş ve üyelik bununla yapılır) ---
# dev: kodu ekranda gösterir ve data/last-otp.txt dosyasına yazar, SMS göndermez.
#      NODE_ENV=production iken reddedilir.
# netgsm veya twilio: gerçek SMS. Boş bırakılırsa üretimde kod istekleri 503 döner.
SMS_PROVIDER=dev
# SMS_DEV_FILE=0            # dev kodunu dosyaya yazma

# Netgsm (SMS_PROVIDER=netgsm). Canlı hesapla henüz denenmedi.
# NETGSM_USERCODE=
# NETGSM_PASSWORD=
# NETGSM_MSGHEADER=          # Netgsm'de onaylı başlık
# NETGSM_OTP_URL=https://api.netgsm.com.tr/sms/send/otp

# Twilio (SMS_PROVIDER=twilio). Canlı hesapla henüz denenmedi.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=               # veya TWILIO_MESSAGING_SERVICE_SID
# TWILIO_MESSAGING_SERVICE_SID=

# --- Cloudflare Turnstile (her SMS gönderiminden önce bot kontrolü) ---
# Üretimde zorunlu; anahtar yoksa SMS istekleri reddedilir. Geliştirmede boş bırakılabilir.
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- E-posta (eski e-postalı hesaplar için doğrulama bağlantısı) ---
# Boşsa geliştirmede bağlantı konsola ve data/last-verify-link.txt dosyasına yazılır.
RESEND_API_KEY=
MAIL_FROM=Bizim Tribun <noreply@localhost>

# --- İstemci IP'si / hız sınırı ---
# none (varsayılan): x-forwarded-for, x-real-ip, cf-connecting-ip yok sayılır.
# cloudflare: yalnızca cf-connecting-ip (trafik Cloudflare üzerinden gelmeli).
# forwarded: güvenilir reverse proxy (nginx); TRUST_PROXY_HOPS kadar içerdeki IP alınır.
# TRUST_PROXY=none
# TRUST_PROXY_HOPS=1

# --- Yalnızca geliştirme: bu kullanıcı adı veya e-posta eşleşirse hesap admin yapılır ---
# Üretimde yok sayılır; üretimde ilk süper admin için docs/admin-bootstrap.md.
# BOOTSTRAP_ADMIN_USERNAME=senin_kullanici_adin
# BOOTSTRAP_ADMIN_EMAIL=sen@ornek.com
