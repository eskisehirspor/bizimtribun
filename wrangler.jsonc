{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "bizimtribun",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // Public settings. Secrets (APP_SECRET, RESEND_API_KEY, TURNSTILE_SECRET_KEY,
  // SUPER_ADMIN_EMAIL)
  // are set with `wrangler secret put`, see docs/cloudflare.md.
  "vars": {
    "APP_URL": "https://bizimtribun.com",
    "TRUST_PROXY": "cloudflare",
    "VERIFY_CHANNEL": "email",
    // Links in mails go to the test address until bizimtribun.com points at
    // this Worker. Remove this line when the domain moves.
    "MAIL_LINK_URL": "https://bizimtribun.bizimtribun.workers.dev"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "b52aecddb119402cbe903779272ed73f",
      // Only used by `wrangler dev`; the deployed Worker uses Supabase.
      "localConnectionString": "postgres://postgres@localhost:5432/postgres"
    }
  ]
}
